# Copy to .env: the app reads it once at start (app/settings.py). Variables already set in the environment win,
# so Docker, CI and the contract runner override any key. Switches accept 1, true, on or yes.

# Where the app listens. `python serve.py` refuses a port something answers on.
APP_PORT=8000
APP_HOST=127.0.0.1

# The SQLite database, uploads, visitor sandboxes and relay snapshots (default: storage/ in this folder)
# DATA_DIR=storage

# Commercial examples (Dashboard, Creator) run without a key and show a licence banner. Set, the pages call
# setLicenseKey(). The SurveyJS service at its pinned revision ignores it, so server PDFs keep the alert banner.
SURVEYJS_LICENSE_KEY=

# Run Server-Side Workflows go through the SurveyJS service: `docker compose up -d surveyjs` publishes it on 3010
SURVEYJS_SERVICE_URL=http://localhost:3010
# app/routes/validate_response.py replaces app/routes/save_response.py
VALIDATE_RESPONSES=false
# app/routes/lint_definition.py replaces app/routes/creator_load_save.py
LINT_DEFINITIONS=false

# Extract Responses from Documents: the SurveyJS service's AI provider (openai, anthropic or ollama).
# docker-compose.yml passes these to the service as AI_PROVIDER, AI_MODEL and OLLAMA_BASE_URL; the app reads
# them only to show or hide the page's banner. SURVEYJS_AI_MODEL is optional (the provider's default).
SURVEYJS_AI_PROVIDER=
SURVEYJS_AI_MODEL=
SURVEYJS_OLLAMA_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Translate with AI: any OpenAI-compatible /chat/completions endpoint. Without a key, /api/translate answers 501.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# The relays run in this app, on its port, at /ws/rooms/<id> and /ws/forms/<id>. Leave these empty to use the page's
# own origin (ws or wss as the visitor sees it); set them to a proxy's origin, e.g. wss://example.com, when it serves
# /ws/ on another host.
RELAY_URL=
EDIT_RELAY_URL=

# Demo only: a private database copy per visitor, removed after 24 hours unused (the hosted demo)
DEMO_MODE=false

# Which checkout answered: `<branch>@<commit>`, shown on the pages as "Running …". Unset, serve.py asks git once.
# SURVEYJS_BUILD=

# Where the pages link: the docs page (each example adds #<anchor>) and the repository (View on GitHub)
# SURVEYJS_DOCS=https://surveyjs.io/documentation/backend-integration-python
# SURVEYJS_GITHUB=https://github.com/surveyjs/surveyjs-python-fastapi

# The proxies uvicorn trusts for X-Forwarded-For and X-Forwarded-Proto (the Docker image sets *)
FORWARDED_ALLOW_IPS=127.0.0.1
