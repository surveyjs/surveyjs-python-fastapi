# Copy to .env. .env is git-ignored and holds only the private keys: everything else is in settings.env, which is
# committed. Values here win over settings.env; variables set in the environment win over both. docker compose
# passes these to the app and the SurveyJS service.

# Commercial examples (Dashboard, Creator) run without a key and show a licence banner. Set, the pages call
# setLicenseKey(). The SurveyJS service at its pinned revision ignores it, so server PDFs keep the alert banner.
SURVEYJS_LICENSE_KEY=

# Extract Responses from Documents: the SurveyJS service's key (the provider and model are in settings.env)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Translate with AI: the key for the endpoint in settings.env (AI_BASE_URL). Without it, /api/translate answers 501.
AI_API_KEY=
